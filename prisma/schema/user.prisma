enum Role {
  PLAYER
  USER
  ADMIN
}

model User {
  // required by next-auth
  id                   String            @id @default(cuid())
  name                 String?
  email                String?           @unique
  emailVerified        DateTime?         @map("email_verified")
  image                String?
  accounts             Account[]
  sessions             Session[]
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  // additional fields
  username             String            @unique @default(cuid())
  passwordHash         String?           @map("password_hash")
  role                 Role              @default(ADMIN)
  // optional 1-n relations
  games                Game[]            @relation("Owner")
  favoritedGames       Game[]            @relation("FavoritedGames")
  votedGames           GameVote[]
  commentsOnGames      GameComment[]
  votedCommentsOnGames GameCommentVote[]
  ratings              GameRating[]
  plays                GamePlay[]
  // denormalized counters
  gameCount            Int               @default(0)
  favoritedGameCount   Int               @default(0)
  totalPlayTime        Int               @default(0)

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
