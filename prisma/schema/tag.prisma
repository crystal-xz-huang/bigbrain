// 18 badge colors from Catalyst: https://catalyst.tailwindui.com/docs/badge
enum Color {
  RED
  ORANGE
  AMBER
  YELLOW
  LIME
  GREEN
  EMERALD
  TEAL
  CYAN
  SKY
  BLUE
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
  ZINC
}

model GameTag {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  color     Color    @default(BLUE)
  // mandatory 1-1 relation to Game (a tag must have a game)
  game      Game     @relation(fields: [gameId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  gameId    String

  @@unique([name, gameId]) // unique tag names per game
  @@index(gameId)
}
